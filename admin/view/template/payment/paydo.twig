{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="float-end">
                <button type="submit" form="form-payment" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary">
                    <i class="fa fa-save"></i>
                </button>
                <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-light">
                    <i class="fa fa-reply"></i>
                </a>
            </div>
            <h1>{{ heading_title }}</h1>
            <ol class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                    <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ol>
        </div>
    </div>
    <div class="container-fluid">
        {% if error_warning %}
            <div class="alert alert-danger alert-dismissible">
                <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        {% endif %}

        <div class="card">
            <div class="card-header">
                <i class="fa fa-pencil"></i> {{ text_edit }}
            </div>
            <div class="card-body">
                <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-payment" class="form-horizontal">
                    <div class="row mb-3 required">
                        <label class="col-sm-2 col-form-label" for="entry-public_id">
                            {{ entry_public_id }}
                        </label>
                        <div class="col-sm-10">
                            <input type="text" name="payment_paydo_public_id"
                                    value="{{ payment_paydo_public_id }}"
                                    placeholder="{{ entry_public_id }}"
                                    autocomplete="off"
                                    id="entry-public_id" class="form-control"/>
                            {% if error_public_id %}
                                <div class="text-danger">{{ error_public_id }}</div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="row mb-3 required">
                        <label class="col-sm-2 col-form-label" for="entry-secret_key">
                            {{ entry_secret_key }}
                        </label>
                        <div class="col-sm-10">
                            <input type="text" name="payment_paydo_secret_key"
                                    value="{{ payment_paydo_secret_key }}"
                                    placeholder="{{ entry_secret_key }}"
                                    autocomplete="off"
                                    id="entry-secret_key" class="form-control"/>
                            {% if error_secret_key %}
                                <div class="text-danger">{{ error_secret_key }}</div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label" for="entry-methods-mode">{{ entry_methods_mode }}</label>
                        <div class="col-sm-10">
                            <select name="payment_paydo_methods_mode" id="entry-methods-mode" class="form-select">
                                <option value="1" {% if payment_paydo_methods_mode %}selected{% endif %}>{{ text_enabled }}</option>
                                <option value="0" {% if not payment_paydo_methods_mode %}selected{% endif %}>{{ text_disabled }}</option>
                            </select>
                            <div class="form-text">{{ help_methods_mode }}</div>
                        </div>
                    </div>

                    <div id="paydo-method-settings">
                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label" for="entry-hosted-page">{{ entry_hosted_page }}</label>
                            <div class="col-sm-10">
                                <select name="payment_paydo_hosted_page_enabled" id="entry-hosted-page" class="form-select">
                                    <option value="1" {% if payment_paydo_hosted_page_enabled %}selected{% endif %}>{{ text_enabled }}</option>
                                    <option value="0" {% if not payment_paydo_hosted_page_enabled %}selected{% endif %}>{{ text_disabled }}</option>
                                </select>
                                <div class="form-text">{{ help_hosted_page }}</div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label" for="entry-project-id">{{ entry_project_id }}</label>
                            <div class="col-sm-10">
                                <input type="text" name="payment_paydo_project_id"
                                       value="{{ payment_paydo_project_id }}"
                                       id="entry-project-id" class="form-control" autocomplete="off"/>
                                <div class="form-text">{{ help_project_id }}</div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label" for="entry-jwt-token">{{ entry_jwt_token }}</label>
                            <div class="col-sm-10">
                                <textarea name="payment_paydo_jwt_token" id="entry-jwt-token"
                                          class="form-control" rows="4" autocomplete="off">{{ payment_paydo_jwt_token }}</textarea>
                                <div class="form-text">{{ help_jwt_token }}</div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label">{{ entry_sync_methods }}</label>
                            <div class="col-sm-10">
                                <button type="button" id="button-sync-methods" class="btn btn-secondary">
                                    <i class="fa fa-refresh"></i> {{ button_sync_methods }}
                                </button>
                                <span id="paydo-sync-status" class="ms-2"></span>
                                <div class="form-text">{{ help_sync_methods }}</div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label" for="paydo-method-search">{{ entry_enabled_methods }}</label>
                            <div class="col-sm-10">
                                <input type="search" id="paydo-method-search" class="form-control mb-2"
                                       placeholder="{{ text_search_methods }}"/>
                                <div id="paydo-methods-list" class="border rounded p-3" style="max-height: 360px; overflow: auto;">
                                    {% if payment_paydo_available_methods %}
                                        {% for identifier, method in payment_paydo_available_methods %}
                                            <label class="paydo-method-row d-flex align-items-center gap-2 mb-2" data-search="{{ method.title|lower }} {{ identifier }}">
                                                <input type="checkbox" class="form-check-input mt-0"
                                                       name="payment_paydo_enabled_methods[]"
                                                       value="{{ identifier }}"
                                                       {% if identifier in payment_paydo_enabled_methods %}checked{% endif %}/>
                                                {% if method.logo %}
                                                    <img src="{{ method.logo }}" alt="" loading="lazy" style="width: auto; height: 24px; max-width: 70px; object-fit: contain;"/>
                                                {% endif %}
                                                <span><strong>{{ method.title }}</strong> <small class="text-muted">#{{ identifier }}</small></span>
                                            </label>
                                        {% endfor %}
                                    {% else %}
                                        <div id="paydo-no-methods" class="text-muted">{{ text_no_methods }}</div>
                                    {% endif %}
                                </div>
                                <div class="form-text">{{ help_enabled_methods }}</div>
                                {% if error_enabled_methods %}
                                    <div class="text-danger">{{ error_enabled_methods }}</div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label" for="entry-ipn_url">
                            IPN URL
                        </label>
                        <div class="col-sm-8">
                            <input type="text"
                                    value="{{ ipn_url }}"                                       
                                    readonly
                                    id="entry-ipn_url" class="form-control"/>
                        </div>
                        <div class="col-sm-2">
                            <button type="button" class="btn btn-default" onclick="copyToClipboard('entry-ipn_url')">
                                <i class="fa fa-clipboard"></i> Copy
                            </button>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label" for="entry-order_status_wait">
                            {{ entry_order_status_wait }}
                        </label>
                        <div class="col-sm-10">
                            <select name="payment_paydo_order_status_wait" id="entry-order_status_wait" class="form-select">
                                {% for status in order_statuses %}
                                    <option value="{{ status.order_status_id }}" {% if payment_paydo_order_status_wait == status.order_status_id %}selected{% endif %}>{{ status.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label" for="entry-order_status_success">
                            {{ entry_order_status_success }}
                        </label>
                        <div class="col-sm-10">
                            <select name="payment_paydo_order_status_success" id="entry-order_status_success" class="form-select">
                                {% for status in order_statuses %}
                                    <option value="{{ status.order_status_id }}" {% if payment_paydo_order_status_success == status.order_status_id %}selected{% endif %}>{{ status.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label" for="entry-order_status_error">
                            {{ entry_order_status_error }}
                        </label>
                        <div class="col-sm-10">
                            <select name="payment_paydo_order_status_error" id="entry-order_status_error" class="form-control">
                                {% for status in order_statuses %}
                                    <option value="{{ status.order_status_id }}" {% if payment_paydo_order_status_error == status.order_status_id %}selected{% endif %}>{{ status.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label" for="entry-sort_order">
                            {{ entry_sort_order }}
                        </label>
                        <div class="col-sm-10">
                            <input type="text" name="payment_paydo_sort_order"
                                       value="{{ payment_paydo_sort_order }}"
                                       placeholder="0"
                                       autocomplete="off"
                                       id="entry-sort_order" class="form-control"/>
                                {% if error_sort_order %}
                                    <div class="text-danger">{{ error_sort_order }}</div>
                                {% endif %}
                        </div>
                    </div>

                    <div class="row mb-3">
                            <label class="col-sm-2 col-form-label" for="entry-status">{{ entry_status }}</label>
                            <div class="col-sm-10">
                                <select name="payment_paydo_status" id="entry-status" class="form-select">
                                    <option value="1" {% if payment_paydo_status %}selected{% endif %}>{{ text_enabled }}</option>
                                    <option value="0" {% if not payment_paydo_status %}selected{% endif %}>{{ text_disabled }}</option>
                                </select>
                            </div>
                        </div>
                </form>
            </div>
        </div>
    </div>
</div>
{{ footer }}

<script>
function copyToClipboard(elementId) {
    var copyText = document.getElementById(elementId);
    copyText.select();
    document.execCommand("copy");
}

function togglePaydoMethodSettings() {
    document.getElementById('paydo-method-settings').style.display =
        document.getElementById('entry-methods-mode').value === '1' ? '' : 'none';
}

function filterPaydoMethods() {
    const query = document.getElementById('paydo-method-search').value.trim().toLowerCase();
    document.querySelectorAll('.paydo-method-row').forEach(function(row) {
        row.style.display = !query || (row.dataset.search || '').includes(query) ? '' : 'none';
    });
}

function renderPaydoMethods(methods) {
    const list = document.getElementById('paydo-methods-list');
    const selected = new Set(Array.from(list.querySelectorAll('input:checked')).map(function(input) {
        return input.value;
    }));
    list.replaceChildren();

    Object.keys(methods).forEach(function(identifier) {
        const method = methods[identifier];
        const label = document.createElement('label');
        label.className = 'paydo-method-row d-flex align-items-center gap-2 mb-2';
        label.dataset.search = ((method.title || '') + ' ' + identifier).toLowerCase();

        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.className = 'form-check-input mt-0';
        checkbox.name = 'payment_paydo_enabled_methods[]';
        checkbox.value = identifier;
        checkbox.checked = selected.has(identifier);
        label.appendChild(checkbox);

        if (method.logo) {
            const logo = document.createElement('img');
            logo.src = method.logo;
            logo.alt = '';
            logo.loading = 'lazy';
            logo.style.cssText = 'width:auto;height:24px;max-width:70px;object-fit:contain';
            label.appendChild(logo);
        }

        const title = document.createElement('span');
        const strong = document.createElement('strong');
        strong.textContent = method.title || ('#' + identifier);
        title.appendChild(strong);
        title.appendChild(document.createTextNode(' #' + identifier));
        label.appendChild(title);
        list.appendChild(label);
    });
}

document.getElementById('entry-methods-mode').addEventListener('change', togglePaydoMethodSettings);
document.getElementById('paydo-method-search').addEventListener('input', filterPaydoMethods);
document.getElementById('button-sync-methods').addEventListener('click', async function() {
    const button = this;
    const status = document.getElementById('paydo-sync-status');
    const body = new URLSearchParams({
        project_id: document.getElementById('entry-project-id').value,
        jwt_token: document.getElementById('entry-jwt-token').value
    });

    button.disabled = true;
    status.className = 'ms-2 text-muted';
    status.textContent = '{{ text_syncing|escape('js') }}';

    try {
        const response = await fetch('{{ sync_methods_url|replace({'&amp;': '&'}) }}', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'},
            body: body.toString()
        });
        const json = await response.json();

        if (!response.ok || json.error) {
            throw new Error(json.error || '{{ error_methods_request|escape('js') }}');
        }

        renderPaydoMethods(json.methods || {});
        status.className = 'ms-2 text-success';
        status.textContent = json.success;
    } catch (error) {
        status.className = 'ms-2 text-danger';
        status.textContent = error.message;
    } finally {
        button.disabled = false;
    }
});

togglePaydoMethodSettings();
</script>
