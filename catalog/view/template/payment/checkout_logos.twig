<script>
(function($) {
  // OpenCart's standard payment picker uses option.name, but ignores option.image.
  // Decorate the labels after it renders, keeping stored payment names as plain text.
  $(document).off('ajaxComplete.paydoLogos').on('ajaxComplete.paydoLogos', function(event, xhr) {
    const json = xhr.responseJSON;
    const methods = json && json.payment_methods && json.payment_methods.paydo;
    if (!methods || !methods.option) return;

    const logos = new Map();
    Object.values(methods.option).forEach(function(option) {
      if (!option.image) return;
      try {
        const url = new URL(option.image);
        if (url.protocol === 'https:' || url.protocol === 'http:') {
          logos.set(option.code, url.href);
        }
      } catch (error) {
        // A missing or invalid logo leaves the payment method's text visible.
      }
    });

    document.querySelectorAll('#modal-payment input[name="payment_method"]').forEach(function(input) {
      const label = input.parentElement.querySelector('label');
      const logo = logos.get(input.value);
      if (!label || !logo || label.querySelector('.paydo-method-logo')) return;

      const image = document.createElement('img');
      image.className = 'paydo-method-logo';
      image.alt = '';
      image.src = logo;
      image.style.cssText = 'width:48px;height:24px;object-fit:contain;vertical-align:middle;margin-right:8px;';
      image.addEventListener('error', function() { image.remove(); });
      label.prepend(image);
    });
  });
})(jQuery);
</script>
